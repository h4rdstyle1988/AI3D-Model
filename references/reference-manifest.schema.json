{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-manifest.schema.json",
  "title": "AI3D reference manifest",
  "type": "object",
  "required": ["schema_version", "project", "references"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo_path", "origin", "availability", "sha256"],
        "properties": {
          "repo_path": { "type": "string", "pattern": "^references/[^/]+/.+" },
          "origin": { "enum": ["real", "generated"] },
          "availability": { "enum": ["available", "missing"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
