{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ruediger result status",
  "type": "object",
  "required": ["schema_version", "task", "revision", "status", "main_files", "validations", "open_real_tests", "user_decision_required", "user_decision_reason", "final_user_approval"],
  "properties": {
    "schema_version": { "const": 1 },
    "task": { "type": "string" },
    "revision": { "type": "string" },
    "status": { "enum": ["PASS", "STOPP", "OFFEN"] },
    "main_files": { "type": "array", "items": { "type": "string" } },
    "validations": { "type": "array", "items": { "type": "object" } },
    "open_real_tests": { "type": "array", "items": { "type": "string" } },
    "user_decision_required": { "type": "boolean" },
    "user_decision_reason": { "type": ["string", "null"] },
    "final_user_approval": { "const": false }
  },
  "additionalProperties": true
}
