{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AI3D-result-status-1.0",
  "type": "object",
  "required": ["schema_version", "task", "revision", "status", "main_files", "validations", "open_real_tests", "user_decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"type": "string"},
    "revision": {"type": "string"},
    "status": {"enum": ["PASS", "STOPP", "OFFEN"]},
    "main_files": {"type": "array", "items": {"type": "string"}},
    "validations": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "OFFEN"]}, "evidence": {"type": "string"}}}},
    "open_real_tests": {"type": "array", "items": {"type": "string"}},
    "user_decisions": {"type": "array", "items": {"type": "string"}},
    "technical_open_points": {"type": "array", "items": {"type": "string"}},
    "final_product_approval": {"const": false}
  },
  "additionalProperties": false
}
